#!/usr/bin/env bash
#PBS -N clean_mms_source_ln
#PBS -q v1_gpu72
#PBS -J 0-19%4
#PBS -l select=1:ncpus=4:mem=32gb:ngpus=1:gpu_type=L40S
#PBS -l walltime=72:00:00
#PBS -j oe
#PBS -o /rds/general/user/hs225/home/TTA_Project_runs/Research/Logs/fully_supervised_source_backbones_ln.log

set -euo pipefail

PROJECT_DIR="/rds/general/user/hs225/home/TTA_Project_runs"
PYTHON_BIN="/rds/general/user/hs225/home/miniforge3/envs/TTA/bin/python"
TRAIN_SCRIPT="${PROJECT_DIR}/Research/backbone_training_FullySupervisedSourceBackbone_LN.py"
OUTPUT_ROOT="${PROJECT_DIR}/Research/backbone_params_cleanSource_LN"

cd "${PROJECT_DIR}"

TASK_ID="${PBS_ARRAY_INDEX:?PBS_ARRAY_INDEX is required}"
DOMAIN_INDEX="$((TASK_ID / 5))"
SEED="$((TASK_ID % 5))"
DOMAINS=(A B C D)
DOMAIN="${DOMAINS[DOMAIN_INDEX]}"

"${PYTHON_BIN}" - <<'PY'
import torch

if not torch.cuda.is_available():
    raise RuntimeError("CUDA is unavailable inside the allocated PBS GPU job.")
print(
    "[CUDA]",
    torch.cuda.get_device_name(0),
    "torch=",
    torch.__version__,
    "runtime=",
    torch.version.cuda,
)
PY

echo "[TASK] id=${TASK_ID} source_domain=${DOMAIN} seed=${SEED} norm=LayerNorm2d"

"${PYTHON_BIN}" "${TRAIN_SCRIPT}" \
  --task-id "${TASK_ID}" \
  --device cuda \
  --output-root "${OUTPUT_ROOT}" \
  --resume
