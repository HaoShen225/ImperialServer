#!/usr/bin/env bash
#PBS -N fairnorm_mms
#PBS -q v1_gpu72
#PBS -J 0-59%4
#PBS -l select=1:ncpus=4:mem=16gb:ngpus=1:gpu_type=L40S
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -o /rds/general/user/hs225/home/TTA_Project_runs/Research/Logs/fairnorm_mms.log

set -euo pipefail

PROJECT_DIR="/rds/general/user/hs225/home/TTA_Project_runs"
PYTHON_BIN="/rds/general/user/hs225/home/miniforge3/envs/TTA/bin/python"
RUN_SCRIPT="${PROJECT_DIR}/Research/sota_FairNorm.py"
OUTPUT_ROOT="${PROJECT_DIR}/Research/FairNorm_results"

cd "${PROJECT_DIR}"

TASK_ID="${PBS_ARRAY_INDEX:?PBS_ARRAY_INDEX is required}"

"${PYTHON_BIN}" - <<'PY'
import torch

if not torch.cuda.is_available():
    raise RuntimeError("CUDA is unavailable inside the allocated PBS GPU job.")
print(
    "[CUDA]",
    torch.cuda.get_device_name(0),
    "torch=",
    torch.__version__,
    "runtime=",
    torch.version.cuda,
)
PY

echo "[TASK] id=${TASK_ID}"

"${PYTHON_BIN}" "${RUN_SCRIPT}" \
  --task-id "${TASK_ID}" \
  --device cuda \
  --output-root "${OUTPUT_ROOT}" \
  --resume
