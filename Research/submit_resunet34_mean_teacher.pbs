#!/usr/bin/env bash
#PBS -N resunet34_mt_imgnet
#PBS -q v1_gpu72
#PBS -J 0-14%4
#PBS -l select=1:ncpus=4:mem=64gb:ngpus=1
#PBS -l walltime=72:00:00
#PBS -j oe
#PBS -o /rds/general/user/hs225/home/TTA_Project_runs/Research/Logs/resunet34_mean_teacher_imagenet.log

set -euo pipefail

PROJECT_DIR="/rds/general/user/hs225/home/TTA_Project_runs"
PYTHON_BIN="/rds/general/user/hs225/home/miniforge3/envs/TTA/bin/python"
TRAIN_SCRIPT="${PROJECT_DIR}/Research/ResUNet34_training_MeanTeacher.py"
OUTPUT_ROOT="${PROJECT_DIR}/Research/ResUNet34_params"
ENCODER_WEIGHTS="${PROJECT_DIR}/Research/Logs/pretrained/resnet34-b627a593.pth"

cd "${PROJECT_DIR}"

TASK_ID="${PBS_ARRAY_INDEX:?PBS_ARRAY_INDEX is required}"
PATIENT_SETTING="$((TASK_ID / 5 + 1))"
SEED="$((TASK_ID % 5))"

"${PYTHON_BIN}" - <<'PY'
import torch

if not torch.cuda.is_available():
    raise RuntimeError("CUDA is unavailable inside the allocated PBS GPU job.")
print(
    "[CUDA]",
    torch.cuda.get_device_name(0),
    "torch=",
    torch.__version__,
    "runtime=",
    torch.version.cuda,
)
PY

echo "[TASK] id=${TASK_ID} Patient${PATIENT_SETTING} Seed${SEED}"

"${PYTHON_BIN}" "${TRAIN_SCRIPT}" \
    --patients "${PATIENT_SETTING}" \
    --seeds "${SEED}" \
    --device cuda \
    --encoder-weights "${ENCODER_WEIGHTS}" \
    --output-root "${OUTPUT_ROOT}" \
    --overwrite
