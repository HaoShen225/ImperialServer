#!/usr/bin/env bash
#PBS -N energytree_cuda_test
#PBS -q v1_gpu72
#PBS -l select=1:ncpus=1:mem=8gb:ngpus=1:gpu_type=L40S
#PBS -l walltime=00:05:00
#PBS -j oe
#PBS -o /rds/general/user/hs225/home/TTA_Project_runs/Research/Logs/energytree_cuda_test.log

set -euo pipefail

PROJECT_DIR="/rds/general/user/hs225/home/TTA_Project_runs"
PYTHON_BIN="/rds/general/user/hs225/home/miniforge3/envs/TTA/bin/python"

module load GCC/11.3.0
module load CUDA/11.8.0
cd "${PROJECT_DIR}"

"${PYTHON_BIN}" - <<'PY'
import torch

if not torch.cuda.is_available():
    raise RuntimeError("CUDA is unavailable inside the EnergyLossTree test job.")
print(
    "[CUDA]",
    torch.cuda.get_device_name(0),
    "torch=",
    torch.__version__,
    "runtime=",
    torch.version.cuda,
)
PY

"${PYTHON_BIN}" -m unittest discover \
    -s Research/helper/EnergyLossTree/tests \
    -v
