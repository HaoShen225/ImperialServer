#!/usr/bin/env bash
#PBS -N mms_sar_bs_pre
#PBS -q v1_gpu72
#PBS -l select=1:ncpus=4:mem=32gb:ngpus=1:gpu_type=L40S
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -o /rds/general/user/hs225/home/mms_TTA/checkpoints/logs/Stochastic_Ini_ForegroundOnly/dual_protocol_patient_bs8_slice_bs4/adaptive_lr_1e-3/sar_preflight_bootstrap.log

set -euo pipefail

PROJECT_DIR="/rds/general/user/hs225/home/mms_TTA"
PYTHON_BIN="/rds/general/user/hs225/home/miniforge3/envs/TTA/bin/python"
LOG_DIR="${PROJECT_DIR}/checkpoints/logs/Stochastic_Ini_ForegroundOnly/dual_protocol_patient_bs8_slice_bs4/adaptive_lr_1e-3/sar"
JOB_TAG="${PBS_JOBID//\//_}"
LOG_FILE="${LOG_DIR}/preflight_${JOB_TAG}.log"

mkdir -p "${LOG_DIR}"
exec >"${LOG_FILE}" 2>&1

module load GCC/11.3.0
module load CUDA/11.8.0
export OMP_NUM_THREADS=4
export MKL_NUM_THREADS=4
export PYTHONUNBUFFERED=1
cd "${PROJECT_DIR}"

echo "[PREFLIGHT] method=sar patient_bs8 slice_bs4 lr=1e-3 job_id=${PBS_JOBID} host=$(hostname) started=$(date --iso-8601=seconds)"
"${PYTHON_BIN}" - <<'PY'
import torch

if not torch.cuda.is_available():
    raise RuntimeError("CUDA is unavailable inside the allocated PBS GPU job")
print("[CUDA]", torch.cuda.get_device_name(0), "torch=", torch.__version__, "runtime=", torch.version.cuda)
PY

"${PYTHON_BIN}" smoke_sar_bs_comparison.py \
  --config config.yaml \
  --seed 2022 \
  --vendor C \
  --device cuda

echo "[PREFLIGHT] method=sar patient_bs8 slice_bs4 lr=1e-3 completed=$(date --iso-8601=seconds)"
